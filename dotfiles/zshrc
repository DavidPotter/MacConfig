##############################################################################
# zshrc
#
# Zsh loader (the zsh counterpart of dotfiles/bash_profile).
# Sets up the shell the way I like it by performing the following actions:
# 1. Source the shared, shell-agnostic scripts in shell.d (functions, env,
#       PATH, aliases, ruby) -- the same files bash sources.
# 2. Source the zsh-specific adapters in zsh.d (completion, history, prompt,
#       line-editor keybindings).
# 3. Add the scripts directory in the repo to the PATH.
# 4. Source scripts in ~/.shell.d then ~/.zsh.d for machine-local config not
#       tracked in this repo.
#
# This file is sourced from ~/.zshrc (installed as a one-line stub by
# install.sh), so it runs for every interactive zsh -- matching the bash setup,
# where all configuration lives in the login profile and only reaches
# interactive Terminal shells.
##############################################################################

# Uncomment the next line to see a verbose listing of this script when running.
# set -x

#-----------------------------------------------------------------------------
# Locate the repository root.
#
# bash uses ${BASH_SOURCE[0]}; the zsh equivalent is the prompt-expansion of
# %x, which yields the path of the file whose code is currently running -- even
# inside a function, where plain $0 / %N would give the function name instead.
# The :A modifier canonicalizes through symlinks to an absolute real path (so a
# symlinked ~/.zshrc still resolves here), and :h:h climbs two directories:
# dotfiles/ -> repo root.
#-----------------------------------------------------------------------------

ROOT_DIR="${${(%):-%x}:A:h:h}"

#-----------------------------------------------------------------------------
# Source every regular file in a directory, in (lexical) glob order.
#  $1 - Directory whose files to source.
#
# The (.N) glob qualifier restricts matches to regular files (.) and enables
# NULL_GLOB (N) so a missing or empty directory expands to nothing rather than
# erroring.  This replaces bash's `for f in "$dir"/*`, which zsh would not
# expand from a variable holding a glob pattern.
#-----------------------------------------------------------------------------

function __source_dir {
    local file
    for file in "$1"/*(.N); do
        source "$file"
    done
}

#-----------------------------------------------------------------------------
# Update environment with Homebrew details.
#
# Only run brew shellenv if it has not already run (e.g. from ~/.zprofile on a
# login shell).  Re-running it here would re-prepend /opt/homebrew/bin to PATH
# and could demote earlier, deliberately higher-priority entries; guarding on
# HOMEBREW_PREFIX keeps whatever ordering ~/.zprofile established.
#-----------------------------------------------------------------------------

if [ -z "${HOMEBREW_PREFIX}" ]; then
    if whence -p brew > /dev/null 2>&1; then
        eval "$(brew shellenv)"
    elif [ -x /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
fi

#-----------------------------------------------------------------------------
# Keep PATH entries unique.
#
# `typeset -U path` ties the `path` array to $PATH and automatically removes
# duplicate entries, so the shared addToPathIfExists (and anything else that
# appends to PATH) can never accumulate duplicates.
#-----------------------------------------------------------------------------

typeset -U path

#-----------------------------------------------------------------------------
# Source common files: shared core first, then zsh-specific adapters.
#-----------------------------------------------------------------------------

__source_dir "${ROOT_DIR}/shell.d"
__source_dir "${ROOT_DIR}/zsh.d"

#-----------------------------------------------------------------------------
# Add the scripts directory to the path.
#-----------------------------------------------------------------------------

if [ -d "${ROOT_DIR}/scripts" ]; then
    addToPathIfExists "${ROOT_DIR}/scripts"
fi

#-----------------------------------------------------------------------------
# Source local files (machine-local, not tracked in this repo): shared local
# config first, then zsh-specific local config.
#-----------------------------------------------------------------------------

__source_dir "${HOME}/.shell.d"
__source_dir "${HOME}/.zsh.d"

#-----------------------------------------------------------------------------
# Clean up the environment.  In zsh, plain `unset` removes variables only, not
# functions, so `unset -f` is required to keep the helper functions from
# leaking into the interactive shell.
#-----------------------------------------------------------------------------

unset -f __source_dir
unset ROOT_DIR
