##############################################################################
# bash_profile
#
# Bash profile (.bash_profile, .bashrc, .profile, etc.).
# Sets up the shell the way I like it by performing the following actions:
# 1. Source the shared, shell-agnostic scripts in shell.d (functions, env,
#       PATH, aliases, ruby) -- the same files the zsh loader sources.
# 2. Source the bash-specific adapters in bash.d (completion, history, prompt).
# 3. Add the scripts directory in the repo to the PATH.
# 4. Source scripts in ~/.shell.d then ~/.bash.d for machine-local config not
#       tracked in this repo (shared-local first, then bash-only local).
##############################################################################

# Uncomment the next line to see a verbose listing of this script when it is running.
# set -x

# Get the path to this script.
function __get_script_dir() {
    local SOURCE="${BASH_SOURCE[0]}"
    # Resolve $SOURCE until the file is no longer a symlink.
    while [ -h "${SOURCE}" ]; do
        SCRIPT_DIR="$( SHELL_SESSION_FILE= && cd -P "$( dirname "${SOURCE}" )" && pwd )"
        SOURCE="$(readlink "${SOURCE}")"
        # If $SOURCE was a relative symlink, resolve it relative to the path where the symlink file was located.
        [[ ${SOURCE} != /* ]] && SOURCE="${SCRIPT_DIR}/${SOURCE}"
    done
    SCRIPT_DIR="$( SHELL_SESSION_FILE= && cd -P "$( dirname "${SOURCE}" )" && pwd )"
}

__get_script_dir

ROOT_DIR="$( SHELL_SESSION_FILE= && cd "$( dirname "${SCRIPT_DIR}" )" && pwd )"

# Source all the scripts in a folder.
#  $1 - Folder containing scripts to source.
function __source_files {
    for file in $1; do
        if [ -f "${file}" ]; then
            source "${file}"
        fi
    done
}

#-----------------------------------------------------------------------------
# Update environment with Homebrew details.
#-----------------------------------------------------------------------------

# Check to see if brew is in the path.  If not, check it's default location.
if which -s brew; then
    eval "$(brew shellenv)"
else
    if [ -f /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
fi

#-----------------------------------------------------------------------------
# Source common files.
#
# The shared, shell-agnostic core (shell.d) is sourced first, then the
# bash-specific adapters (bash.d).  The zsh loader (dotfiles/zshrc) sources the
# same shell.d core followed by its own zsh.d adapters, so both shells share the
# portable configuration and only differ in the shell-specific pieces.
#-----------------------------------------------------------------------------

if [ -d "${ROOT_DIR}/shell.d" ]; then
    __source_files "${ROOT_DIR}/shell.d/*"
fi

if [ -d "${ROOT_DIR}/bash.d" ]; then
    __source_files "${ROOT_DIR}/bash.d/*"
fi

#-----------------------------------------------------------------------------
# Add the scripts directory to the path.
#-----------------------------------------------------------------------------

if [ -d "${ROOT_DIR}/scripts" ]; then
    addToPathIfExists "${ROOT_DIR}/scripts"
fi

#-----------------------------------------------------------------------------
# Source local files (machine-local, not tracked in this repo): shared local
# config first, then bash-specific local config.  The zsh loader sources
# ~/.shell.d the same way, so machine-local config that applies to both shells
# lives in ~/.shell.d and is written only once.
#-----------------------------------------------------------------------------

if [ -d "${HOME}/.shell.d" ]; then
    __source_files "${HOME}/.shell.d/*"
fi

if [ -d "${HOME}/.bash.d" ]; then
    __source_files "${HOME}/.bash.d/*"
fi

# Clean up the environment.
unset __get_script_dir
unset __source_files
unset SCRIPT_DIR
unset ROOT_DIR
