# This file contains base configuration for Git.
#
# Include this file in your ~/.gitconfig file:
# [include]
#     path = ~/bin/MacConfig/config/gitconfig-base

[core]
	excludesfile = ~/.gitignore_global
	# Explicitly specify an editor that exits when it's done.
	#editor = pico
	#editor = /usr/local/bin/mate -w
	#editor = atom --wait
	editor = code --wait

[push]
	# default = upstream
	# simple is same as upstream except refuses to push if the upstream branch's name is different from the local one.
	default = simple

[difftool "sourcetree"]
	path =
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
# " <-- need this to close quote from previous line

[mergetool "sourcetree"]
	cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true

[filter "media"]
	clean = git media clean %f
	smudge = git media smudge %f
	required = true

# Pull in settings scoped to the MacConfig repo itself.  `gitdir:` matches on
# the repo's git directory, so gitconfig-macconfig applies only when git is
# operating inside this clone -- not to every repo on the machine.  The `~`
# expands to $HOME, and install.sh always clones to $HOME/bin/MacConfig, so
# this matches on any machine regardless of username.  The trailing slash
# matches the directory and everything under it.
[includeIf "gitdir:~/bin/MacConfig/"]
	path = ~/bin/MacConfig/config/gitconfig-macconfig
